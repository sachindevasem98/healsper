# Copy to .env for local dev, or set these in the platform dashboard (Render/Railway).
# Values shown are placeholders — never commit real secrets.

# Transaction pooler (PgBouncer) — used by the running service
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Session-mode connection — used by Prisma CLI for migrations (migrate deploy / db push)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Long random secret (>= 32 chars) — rotate to invalidate all issued JWTs
JWT_SECRET="replace-with-a-long-random-secret"
# The exact origin of the deployed web app (enables CORS + WebSocket)
WEB_ORIGIN="http://localhost:5173"
PORT=4000